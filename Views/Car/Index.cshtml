@model List<wt_lab4_4mvc_zhiznevskaya.Models.Car>
@{
    ViewData["Title"] = "Автопарк";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Автопарк</h1>
            <p class="text-muted">Система управления автомобилями</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Добавить автомобиль</a>
    </div>

    <div class="row g-4">
        @foreach (var car in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @car.Id</span>
                        <h5 class="card-title">@car.Brand @car.Model</h5>
                        <p class="text-muted mb-2">Год: @car.Year</p>
                        <p class="fs-4 fw-bold">@car.PricePerDay BYN</p>
                        @if (car.IsAvailable)
                        {
                            <span class="badge bg-success">Доступен</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Не доступен</span>
                        }
                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>