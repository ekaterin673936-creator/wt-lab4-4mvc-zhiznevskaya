@model wt_lab4_4mvc_zhiznevskaya.Models.Car
@{
    ViewData["Title"] = "Удалить автомобиль";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4 border-danger">
                <div class="card-body p-4">
                    <h2 class="mb-4 fw-bold text-danger">Удалить автомобиль?</h2>

                    <p>Вы уверены, что хотите удалить:</p>
                    <p class="fs-5"><strong>@Model.Brand @Model.Model</strong> (@Model.Year г.)</p>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Удалить</button>
                            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>